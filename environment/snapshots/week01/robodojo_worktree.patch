+    def _add_slot_wall_colliders(self):
+        """Add thin box colliders as V-slot side walls for vertical_coin_stand.
+
+        Called when ``ACT_STAND_DISABLE_SOLID=1``.  The asset's solid collision
+        block fills the slot entirely, so disabling it opens the slot but
+        removes the side walls that constrain the coin.  This method adds two
+        thin box colliders either side of the slot so the coin stays centred
+        and the gripper can still enter.
+
+        Tuneable environment variables (metres):
+          ``ACT_SLOT_GAP``          – total gap between the two walls (default 0.003)
+          ``ACT_SLOT_WALL_HEIGHT``  – vertical extent of each wall (default 0.012)
+          ``ACT_SLOT_WALL_LENGTH``  – wall length along the slot / x-axis (default 0.028)
+          ``ACT_SLOT_WALL_Z_BOTTOM`` – bottom height in the stand frame (default -0.004)
+        """
+        try:
+            slot_gap = float(os.environ.get("ACT_SLOT_GAP", "0.003"))
+            wall_height = float(os.environ.get("ACT_SLOT_WALL_HEIGHT", "0.012"))
+            wall_length = float(os.environ.get("ACT_SLOT_WALL_LENGTH", "0.028"))
+            wall_thickness = 0.001  # fixed – just needs to be non-zero
+
+            # Keep the walls below the coin centre so the gripper can reach
+            # the exposed upper half. Override when matching a revised asset.
+            wall_z_bottom = float(os.environ.get("ACT_SLOT_WALL_Z_BOTTOM", "-0.004"))
+            wall_z_center = wall_z_bottom + wall_height / 2.0
+
+            half_gap = slot_gap / 2.0
+            # Distance from the centreline (y=0) to the centre of each wall box.
+            wall_y_offset = half_gap + wall_thickness / 2.0
+
+            for side, y_sign in [("left", -1.0), ("right", 1.0)]:
+                wall_path = f"{self._prim_path}/collision/slot_wall_{side}"
+                cube = UsdGeom.Cube.Define(self.stage, wall_path)
+                # UsdGeom.Cube defaults to size=2, so make it a unit cube
+                # before using scale as the requested final dimensions.
+                cube.CreateSizeAttr(1.0)
+                cube.AddTranslateOp().Set(
+                    Gf.Vec3f(0.0, y_sign * wall_y_offset, wall_z_center)
+                )
+                cube.AddScaleOp().Set(Gf.Vec3f(wall_length, wall_thickness, wall_height))
+                UsdPhysics.CollisionAPI.Apply(cube.GetPrim())
+                print(
+                    f"[GeometryObject] {self.instance_name}: "
+                    f"added slot wall '{side}' at y={y_sign * wall_y_offset:.4f} "
+                    f"(gap={slot_gap:.4f} height={wall_height:.4f} length={wall_length:.4f})"
