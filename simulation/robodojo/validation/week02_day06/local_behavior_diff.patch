+    def _add_slot_wall_colliders(self):
+        """Add thin box colliders as V-slot side walls for vertical_coin_stand.
+
+        Called when ``ACT_STAND_DISABLE_SOLID=1``.  The asset's solid collision
+        block fills the slot entirely, so disabling it opens the slot but
+        removes the side walls that constrain the coin.  This method adds two
+        thin box colliders either side of the slot so the coin stays centred
+        and the gripper can still enter.
+
+        Tuneable environment variables (metres):
+          ``ACT_SLOT_GAP``          – total gap between the two walls (default 0.003)
+          ``ACT_SLOT_WALL_HEIGHT``  – vertical extent of each wall (default 0.012)
+          ``ACT_SLOT_WALL_LENGTH``  – wall length along the slot / x-axis (default 0.028)
+          ``ACT_SLOT_WALL_Z_BOTTOM`` – bottom height in the stand frame (default -0.004)
+        """
+        try:
+            slot_gap = float(os.environ.get("ACT_SLOT_GAP", "0.003"))
+            wall_height = float(os.environ.get("ACT_SLOT_WALL_HEIGHT", "0.012"))
+            wall_length = float(os.environ.get("ACT_SLOT_WALL_LENGTH", "0.028"))
+            wall_thickness = 0.001  # fixed – just needs to be non-zero
+
