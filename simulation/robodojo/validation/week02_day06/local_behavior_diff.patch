+                # UsdGeom.Cube defaults to size=2, so make it a unit cube
+                # before using scale as the requested final dimensions.
+                cube.CreateSizeAttr(1.0)
+                cube.AddTranslateOp().Set(
+                    Gf.Vec3f(0.0, y_sign * wall_y_offset, wall_z_center)
+                )
