+def prepare_act_input_color(color, color_order=None):
+    """Apply the explicit runtime color contract before ACT tensor packing."""
+    order = (color_order or os.environ.get("ACT_INPUT_COLOR_ORDER", "bgr")).lower()
+    if order == "bgr":
+        return cv2.cvtColor(color, cv2.COLOR_RGB2BGR)
+    if order == "rgb":
+        return color
+    raise ValueError("ACT_INPUT_COLOR_ORDER must be 'bgr' or 'rgb'")
+
+
+class _DummyACT:
+    """Lightweight placeholder used when we are replaying recorded actions.
+
+    It avoids loading the full ACT network / curobo warm-start, which saves
+    GPU memory and startup time during GT-replay diagnostics.
+    """
+    def __init__(self):
+        self.temporal_agg = False
+        self.t = 0
+
+    def update_obs(self, obs):
+        pass
+
